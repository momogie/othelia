@page
@model Othelia.Api.Pages.Account.LoginModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — Othelia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background: #0c0c1d; color: #e8e9f3;
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
        }
        .login-card {
            width: 340px; background: #13132a; border: 1px solid #262b3a;
            border-radius: 12px; padding: 32px 28px;
        }
        .logo { font-size: 34px; text-align: center; margin-bottom: 8px; }
        h1 { font-size: 20px; font-weight: 700; text-align: center; }
        .sub { font-size: 12px; color: #8b93a7; text-align: center; margin-bottom: 24px; }
        label { display: block; font-size: 11.5px; font-weight: 600; color: #9aa0b6; margin: 14px 0 6px; }
        input {
            width: 100%; padding: 9px 12px; font-size: 13px; color: #e8e9f3;
            background: #0c0c1d; border: 1px solid #262b3a; border-radius: 7px; outline: none;
        }
        input:focus { border-color: #7c5cbf; }
        button {
            width: 100%; margin-top: 22px; padding: 10px; font-size: 13.5px; font-weight: 600;
            background: #7c5cbf; color: #fff; border: none; border-radius: 7px; cursor: pointer;
        }
        button:hover { background: #8b6ccb; }
        .err { color: #e74c3c; font-size: 12px; margin-top: 14px; text-align: center; }
        .hint { font-size: 10.5px; color: #555578; text-align: center; margin-top: 18px; }
    </style>
</head>
<body>
    <form method="post" class="login-card">
        <div class="logo">🔭</div>
        <h1>Othelia</h1>
        <div class="sub">Distributed Tracing — Sign in</div>
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="err">@Model.Error</div>
        }
        <label for="Username">Username</label>
        <input id="Username" asp-for="Username" autocomplete="username" autofocus required />
        <label for="Password">Password</label>
        <input id="Password" asp-for="Password" type="password" autocomplete="current-password" required />
        <button type="submit">Sign in</button>
        <div class="hint">Default: admin / admin123</div>
    </form>
</body>
</html>
