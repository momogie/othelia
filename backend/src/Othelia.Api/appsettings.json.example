// appsettings.json.example — Othelia.Api (dashboard + OTLP receiver)
// Salin menjadi appsettings.json lalu isi nilai <...>.
// Jika AppAPI di server terpisah: set Tracing:Receiver:Host = "0.0.0.0" + buka firewall port 4318.

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Tracing": {
    "Ingestion": {
      "Enabled": true,
      "Endpoint": "http://0.0.0.0:4318"
    },
    "Storage": {
      "Provider": "SqlServer",
      "ConnectionString": "Server=<sql-host>;Database=othelia;User Id=<user>;Password=<pass>;TrustServerCertificate=True;"
    },
    "Query": {
      "MaxTracesPerRequest": 100,
      "DefaultLookbackSeconds": 3600,
      "SlowThresholdMs": 1000,
      "DashboardWindowSeconds": 86400,
      "DashboardBuckets": 24
    },
    "Api": {
      "Host": "localhost",
      "Port": 5007
    },
    "Receiver": {
      "Host": "0.0.0.0",
      "Port": 4318
    },
    "Retention": {
      "Enabled": true,
      "RetentionDays": 7,
      "CleanupIntervalHours": 24
    }
  }
}
