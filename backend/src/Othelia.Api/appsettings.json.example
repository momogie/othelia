// appsettings.json.example — Othelia.Api (dashboard + OTLP receiver)
// Salin menjadi appsettings.json lalu isi nilai <...>.
// Jika AppAPI di server terpisah: set Tracing:Receiver:Host = "0.0.0.0" + buka firewall port 4318.

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Auth": {
    "Users": [
      {
        "Username": "admin",
        "Password": "admin123",
        "DisplayName": "Admin",
        "Role": "Admin"
      }
    ],
    "CookieExpireHours": 12
  },

  "Tracing": {
    "Ingestion": {
      "Enabled": true,
      "Endpoint": "http://0.0.0.0:4318",
      // Kosongkan untuk menerima tanpa auth. Isi token agar /v1/* menolak kiriman tanpa X-Otlp-Token yang sama.
      "ApiKey": "",
      "MaxPayloadBytes": 33554432
    },
    "Storage": {
      "Provider": "SqlServer",
      "ConnectionString": "Server=<sql-host>;Database=othelia;User Id=<user>;Password=<pass>;TrustServerCertificate=True;"
    },
    "Query": {
      "MaxTracesPerRequest": 100,
      "MaxSpansPerTrace": 5000,
      "DefaultLookbackSeconds": 3600,
      "SlowThresholdMs": 1000,
      "DashboardWindowSeconds": 86400,
      "DashboardBuckets": 24
    },
    "Alerts": {
      "Enabled": true,
      "MaxAlerts": 10,
      "ErrorRateDownThreshold": 5.0
    },
    "Metrics": {
      "Enabled": true,
      "DefaultBucketSeconds": 60,
      "MaxSeriesPoints": 1000
    },
    "ServiceMap": {
      "WindowSeconds": 86400
    },
    "Collectors": {
      "WindowSeconds": 3600,
      "StaleMinutes": 5
    },
    "Live": {
      "StreamIntervalSeconds": 5
    },
    "Api": {
      "Host": "localhost",
      "Port": 5007
    },
    "Receiver": {
      "Host": "0.0.0.0",
      "Port": 4318
    },
    "Retention": {
      "Enabled": true,
      "RetentionDays": 7,
      "CleanupIntervalHours": 24
    }
  }
}
